# ─────────────────────────────────────────────────────────────
#  BO_WATCH — Variables d'environnement (template)
# ─────────────────────────────────────────────────────────────
#  Copier ce fichier en ".env" puis remplir les vraies valeurs.
#  Le ".env" n'est JAMAIS commité (voir .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Base de données MySQL ──
DB_USER=root
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bo_watch

# ── JWT ──
# Générer une clé aléatoire forte :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_to_a_random_64_char_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Seuils ML ──
SEUIL_SIMILARITE=0.85

# ── Environnement ──
# Valeurs : "development" | "production"
ENV=development
DEBUG=true

# ── CORS (frontend) ──
FRONTEND_URL=http://localhost:3000

# ── Scraper sgg.gov.ma ──
SCRAPER_USER_AGENT=BO_WATCH/1.0 (Plastima Casablanca)
SCRAPER_TIMEOUT=30
