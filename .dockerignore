# Git
.git
.gitignore
.gitattributes

# Python
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
.pytest_cache
.coverage
.mypy_cache
.ruff_cache
.venv
venv
env

# Node
node_modules
npm-debug.log
yarn-error.log
.pnpm-store

# IDE / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Donnees / cache local
backend/uploads/*
backend/cache/*
backend/storage/*
!backend/uploads/.gitkeep
!backend/cache/.gitkeep
