# Il DOIT etre inclus dans l'image (pas d'exclusion ici).

# Logs
*.log
logs/

# Variables d'environnement (jamais dans l'image)
.env
.env.local
.env.*.local

# Documentation / rapport
rapport/
docs/
*.pdf
*.tex
*.docx
*.pptx
*.xlsx

# Tests
tests/
backend/test_*.py
backend/debug_*.py

# Build frontend (genere par Docker)
frontend/dist/
frontend/build/

# Modeles ML volumineux deja copies via la couche modeles/
